{
  "name": "@psd-studio/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "tsx watch src/worker/main.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(no lint configured for api)\"",
    "test": "vitest run --config vitest.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@psd-studio/scene-graph": "workspace:*",
    "@psd-studio/psd-engine": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/jwt": "^12.0.2",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/client": "6.19.3",
    "@simplewebauthn/server": "^14.0.2",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.0.1",
    "otpauth": "^9.5.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
