# --- Database ---
DATABASE_URL="postgresql://psdstudio:psdstudio_dev_pw@localhost:5432/psdstudio?schema=public"

# --- Redis / queues ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# WebAuthn relying party — must match the origin the browser sees.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="PSD Template Studio"
WEBAUTHN_ORIGIN="http://localhost:5173"
# 32+ byte random secret, base64. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="change-me-dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="10m"
JWT_REFRESH_TTL="30d"
# Pepper mixed into password hashes (Argon2id), held like a secret — not the salt.
PASSWORD_PEPPER="change-me-dev-only-pepper-change-me"

# --- Storage (local-disk driver for dev; swap for S3/R2 in prod via STORAGE_DRIVER) ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage-data"
# S3-compatible (Cloudflare R2 in prod) — used when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# --- App ---
NODE_ENV="development"
API_PORT="3000"
API_PUBLIC_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"
# Set to "true" only when actually deployed behind a reverse proxy (Railway,
# Cloudflare) — it changes how req.ip is derived for rate limiting/audit logs.
TRUST_PROXY="false"
